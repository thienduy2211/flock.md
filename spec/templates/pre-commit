#!/bin/sh
# Run from Git's working-tree root. Installation and migration: docs/ENFORCE.md.
# The gate reads staged Git objects, never checks out or stages working files.

GATE="${FLOCK_GATE:-tools/check-staged.mjs}"

if ! command -v node >/dev/null 2>&1; then
  echo "flock: Node.js is required; commit blocked" >&2
  exit 1
fi
if [ ! -f "$GATE" ]; then
  echo "flock: staged gate not found at $GATE; vendor tools/ or set FLOCK_GATE; commit blocked" >&2
  exit 1
fi

exec node "$GATE" .
